# RustFS / MinIO (S3-compatible)
RUSTFS_ENDPOINT=https://your-rustfs-endpoint
RUSTFS_BUCKET=unos-first
RUSTFS_ACCESS_KEY=your-access-key
RUSTFS_SECRET_KEY=your-secret-key
RUSTFS_REGION=us-east-1

# Admin credentials
ADMIN_PASSWORD=change-me-to-something-strong
ADMIN_JWT_SECRET=change-this-to-a-random-64-char-string
